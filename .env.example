NODE_ENV=development
PORT=5001
# For MongoDB Atlas include the database name in the path, e.g. ...mongodb.net/khamosh-alfaaz?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017/khamosh-alfaaz
SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated allowed CORS origins. In production include the Vercel frontend:
# CLIENT_URL=https://khamosh-alfaaz-client.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
# Session lifetime in milliseconds (24 hours = 86400000)
SESSION_MAX_AGE_MS=86400000
